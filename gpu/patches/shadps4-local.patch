+bool Swapchain::SurfaceUsable() const {
+    const auto [capabilities_result, capabilities] =
+        instance.GetPhysicalDevice().getSurfaceCapabilitiesKHR(surface);
+    if (capabilities_result != vk::Result::eSuccess) {
+        return false;
+    }
+    if (capabilities.currentExtent.width == std::numeric_limits<u32>::max()) {
+        return true; // the surface takes its size from the swapchain
+    }
+    return capabilities.currentExtent.width != 0 && capabilities.currentExtent.height != 0;
+}
