+// --- JStarsReborn diagnostics: PM4 trace -------------------------------------------------------
+// Records the most recent packet headers of one command buffer and, when the processor reaches a
+// packet it cannot handle, logs them together with the raw dwords around the failure point so the
+// failing submission can be diagnosed from the log alone. Local patch: see gpu/patches.
+extern "C" const char* jgpu_data_dir(void);
+namespace {
+struct Pm4Ring {
+    static constexpr size_t N = 40;
+    const u32* base{};
+    size_t total{};
+    struct Entry {
+        u32 off, hdr;
+    } ring[N]{};
+    size_t count{};
+
+    explicit Pm4Ring(std::span<const u32> buf) : base{buf.data()}, total{buf.size()} {}
+    void Add(const u32* p) {
+        ring[count % N] = {static_cast<u32>(p - base), *p};
+        ++count;
+    }
+    void Dump(const char* why, const u32* at) const {
+        LOG_CRITICAL(Lib_GnmDriver,
+                     "PM4 TRACE: {} at dword offset {} of {} (buffer {:#x}); raw dwords around it:",
+                     why, static_cast<size_t>(at - base), total, reinterpret_cast<uintptr_t>(base));
+        const s64 first = std::max<s64>(0, static_cast<s64>(at - base) - 24);
+        const s64 last = std::min<s64>(static_cast<s64>(total), static_cast<s64>(at - base) + 16);
+        for (s64 i = first; i < last; i += 8) {
+            std::string line = fmt::format("  [{:6}]", i);
+            for (s64 j = i; j < std::min<s64>(i + 8, last); ++j) {
+                line += fmt::format(" {:08x}", base[j]);
+            }
+            LOG_CRITICAL(Lib_GnmDriver, "{}", line);
+        }
+        LOG_CRITICAL(Lib_GnmDriver, "PM4 TRACE: last {} packet headers, oldest first:",
+                     std::min(count, N));
+        for (size_t i = count > N ? count - N : 0; i < count; ++i) {
+            const auto& e = ring[i % N];
+            const u32 type = e.hdr >> 30;
+            if (type == 3) {
+                LOG_CRITICAL(Lib_GnmDriver,
+                             "  [{:6}] hdr {:08x} type3 opcode {:#04x} body-dwords {}", e.off,
+                             e.hdr, (e.hdr >> 8) & 0xff, ((e.hdr >> 16) & 0x3fff) + 1);
+            } else {
+                LOG_CRITICAL(Lib_GnmDriver, "  [{:6}] hdr {:08x} type{}", e.off, e.hdr, type);
+            }
+        }
+        // Raw copy of the whole buffer next to the log for offline analysis.
+        const std::string path = fmt::format("{}/pm4-failing-buffer-{:x}.bin", jgpu_data_dir(),
+                                             reinterpret_cast<uintptr_t>(base));
+        if (FILE* f = fopen(path.c_str(), "wb")) {
+            fwrite(base, 4, std::min<size_t>(total, 1u << 20), f);
+            fclose(f);
+            LOG_CRITICAL(Lib_GnmDriver, "PM4 TRACE: wrote {} dwords to {}", total, path);
+        }
+    }
+};
+} // namespace
+
+// JStarsReborn diagnostics: draw trace. JGPU_TRACE_DRAWS="first,count" logs a summary of draws number
+// [first, first+count) (counted from the start of the run) so a steady-state frame can be inspected.
+namespace {
+std::atomic<u64> g_draw_serial{0};
+u64 TraceFirst() {
+    static const u64 v = [] { const char* e = getenv("JGPU_TRACE_DRAWS"); return e ? strtoull(e, nullptr, 10) : ~0ull; }();
+    return v;
+}
+u64 TraceCount() {
+    static const u64 v = [] {
+        const char* e = getenv("JGPU_TRACE_DRAWS");
+        const char* c = e ? strchr(e, ',') : nullptr;
+        return c ? strtoull(c + 1, nullptr, 10) : 0ull;
+    }();
+    return v;
+}
+u64 HashBytes(const void* p, size_t n) {
+    u64 h = 1469598103934665603ull;
+    const auto* b = static_cast<const u8*>(p);
+    for (size_t i = 0; i < n; i++) h = (h ^ b[i]) * 1099511628211ull;
+    return h;
+}
+void TraceDraw(const AmdGpu::Regs& regs, const char* kind, u32 count) {
+    const u64 n = g_draw_serial++;
+    if (n < TraceFirst() || n >= TraceFirst() + TraceCount()) return;
+    const auto* ps = regs.ps_program.Address<const u8*>();
+    const auto* vs = regs.vs_program.Address<const u8*>();
+    u8 psb[128]{}, vsb[128]{};
+    const auto* host = ::jgpu_host_ptr();
+    const size_t pn = ps && host ? host->safe_read(psb, ps, sizeof psb) : 0;
+    const size_t vn = vs && host ? host->safe_read(vsb, vs, sizeof vsb) : 0;
+    const auto& cb = regs.color_buffers[0];
+    LOG_INFO(Lib_GnmDriver,
+             "DRAW #{} {} count={} prim={} vs={:#x}(h{:016x}) ps={:#x}(h{:016x}) rt0={:#x} fmt={} scissor=({},{})-({},{})",
+             n, kind, count, static_cast<u32>(regs.primitive_type),
+             reinterpret_cast<uintptr_t>(vs), HashBytes(vsb, vn), reinterpret_cast<uintptr_t>(ps),
+             HashBytes(psb, pn), static_cast<u64>(cb.Address()), static_cast<u32>(cb.info.format),
+             regs.screen_scissor.top_left_x, regs.screen_scissor.top_left_y,
+             regs.screen_scissor.bottom_right_x, regs.screen_scissor.bottom_right_y);
+    // jstars 0.5.4: every bound render target and the depth buffer (finding the main pass, its depth and any velocity
+    // buffer for FSR). rtN=address:pitch x height:data format/number format:write mask.
+    std::string rts;
+    for (u32 i = 0; i < AmdGpu::NUM_COLOR_BUFFERS; ++i) {
+        const auto& c = regs.color_buffers[i];
+        const u32 mask = regs.color_target_mask.GetMask(i);
+        if (!c || !mask) continue;
+        rts += fmt::format(" rt{}={:#x}:{}x{}:{}/{}:{:x}", i, static_cast<u64>(c.Address()), c.Pitch(), c.Height(),
+                           static_cast<u32>(c.GetDataFmt()), static_cast<u32>(c.GetNumberFmt()), mask);
+    }
+    const auto& db = regs.depth_buffer;
+    LOG_INFO(Lib_GnmDriver, "DRAW #{} targets{} depth={:#x}:{}x{}:z{}:{}{}", n, rts.empty() ? " none" : rts.c_str(),
+             static_cast<u64>(db.DepthValid() ? db.DepthAddress() : 0), db.Pitch(), db.Height(), static_cast<u32>(db.z_info.format),
+             regs.depth_control.depth_enable ? "test" : "-", regs.depth_control.depth_write_enable ? "+write" : "");
+}
+} // namespace
